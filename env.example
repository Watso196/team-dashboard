# Team Pulse — ADO Dashboard Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is never committed to version control (it contains your PAT).
#
# Usage: python serve.py
# The server reads this file and pre-fills the dashboard form automatically.
# ─────────────────────────────────────────────────────────────────────────────

# Your Azure DevOps organization URL (no trailing slash)
ADO_ORG_URL=https://dev.azure.com/your-org

# The ADO project name (exact, case-sensitive), e.g. Design, or InternalTools, etc.
ADO_PROJECT=YourProject

# The ADO team name — find it under Project Settings → Teams
# If you get a 404, try appending " Team" (e.g. "Accessibility Team")
ADO_TEAM=YourTeam

# Personal Access Token
# Generate at: dev.azure.com → User Settings (top-right avatar) → Personal Access Tokens
# Required scopes: Work Items (Read), Code (Read), Project and Team (Read)
# Tokens expire — regenerate here if you start seeing 401 errors.
ADO_PAT=your-pat-here

# Team members to track — comma-separated display names exactly as they appear in ADO
ADO_MEMBERS=Bob Belcher, Linda Belcher, Tina Belcher

# Projects to scan for work item activity.
ADO_PR_PROJECTS=MyProject, AnotherProject

# Whether you would like to track via the iterations on your project's backlog (e.g. sprints), or whether you prefer to use two week date ranges for your sprint breakdown
ADO_SPRINT_MODE="iterations"
# If you prefer two week sprints, use the following instead:
# ADO_SPRINT_MODE="dates"

# (Optional) The number of historical iterations/sprint periods you want to track, including the current sprint/iteration. Defaults to 12 if you do not enter a value.
# ADO_SPRINT_COUNT=12

# (Optional) Choose whether you would like to see the work items your team members own which have had the Design Review tag added and removed for tracking Design Review quality and repetition. If true, will run analysis. By default, this will not run.
# ADO_DESIGN_REVIEW=true

